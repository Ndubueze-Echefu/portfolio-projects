trigger1 = 1
value = SCA

[State 900,to stand]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim!= 900
value = 900

[State 900, BindToRoot]
Type = VelSet
Trigger1 = 1
X = (Rootdist X - 50) / 10
Y = (Rootdist Y - 10) / 10

[State 900, Turn]
Type = Turn
Trigger1 = Facing != Root,Facing

[State 900, ChangeState]
type = ChangeState
trigger1 = parent, stateno = 182
trigger1 = parent, ctrl = 0
trigger1 = timemod = 2,0
value = 901

