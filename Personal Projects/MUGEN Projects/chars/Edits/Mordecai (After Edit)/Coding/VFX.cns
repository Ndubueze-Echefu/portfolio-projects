;Coding for Visual Special Effects
;-----------------------------------------------------------------------------------
; Special/Hyper Finish
[Statedef 8000]
type    = S
movetype = I
physics = N
anim = 8000

[State 8000, "Hyper Combo KOOOOoooo..."]
type = PlaySnd
trigger1 = root, stateno = [6000,6020];	Finished enemy off with any hyper!
triggerall = time >= 30
value = S8000,0
persistent = 0

[State 8000, Dramatic Finish SFX]
type = PlaySnd
trigger1 = root, stateno = [6000,6020];	Finished enemy off with any hyper!
value = S8000,1
persistent = 0


[State 8000, Regular Show Title Screen Background]
type = Explod
trigger1 = root, stateno = [6000,6020];	Finished enemy off with any hyper!
anim = 40000
ID = 40000
bindtime = -1
space = screen
postype = Left
pos = 0, 200
scale = GameWidth/320, GameHeight/240
sprpriority = 0
persistent = 0

[State 8000, Super Finish FX]
type = Explod
trigger1 = root, stateno = [6000,6020];	Finished enemy off with any hyper!
anim = 40006
ID = 40006
bindtime = -1
space = screen
postype = Left
pos = 0, 200
scale = GameWidth/320, GameHeight/240
sprpriority = 10
persistent = 0


[State 8000, Text: "Society Laser"]
type = Explod
trigger1 = root, stateno = 6000;	Finished enemy off with Society Laser!
anim = 40001
ID = 40001
bindtime = -1
space = screen
scale = 0.75, 0.75 * (1.3333333 * GameHeight / GameWidth)
postype = Left
pos = 325, 225
sprpriority = 1
persistent = 0

[State 8000, Text: "Society Laser" (Effect version)]
type = Explod
trigger1 = root, stateno = 6000;	Finished enemy off with Society Laser!
anim = 40001
ID = 40002
bindtime = -1
space = screen
scale = 0.75, 0.75
postype = Left
pos = 325, 225
sprpriority = 1
persistent = 0

[State 8000, Fade away Background 🚩]
type = ModifyExplod
ID = 40000
trigger1 = NumExplod(40000)
trans = addalpha
alpha = 256 - (10 * Time), 10 * Time

[State 8000, Fade "Society Laser" (Effect version)]
type = ModifyExplod
trigger1 = NumExplod(40002)
ID = 40002
scale = 0.75 + (0.0625 * Time), 0.75 + (0.0625 * Time)
trans = AddAlpha
alpha = 256 - (32 * Time), 32 * Time
;---------------------------------------------------------------------------
; VFX - Level 1 Flash
[Statedef 20000]
anim = 999999
ctrl = 0

;=============Coding inspired from Pots===========================================
[State 20000, Lv1 BG Pal]
type = bgpalfx
trigger1 = time <= 5
time = 1
add = 256 -ceil(25.6 * time), 256 -ceil(25.6 * time), 256 -ceil(25.6 * time)
mul = 256 -floor(25.6 * time), 256 -floor(25.6 * time), 256
color = 256 -floor(25.6 * time)

[State 20000, Lv1 BG Pal]
type = bgpalfx
trigger1 = (time = [6, 69])
time = 1
mul = 0, 0, 255
color = 0

[State 20000, Lv1 BG Pal]
type = bgpalfx
trigger1 = time >= 70
time = 1
mul = ceil(51.2 * (time -40)), ceil(51.2 * (time -40)), 256
color = floor(51.2 * (time -40))
;====================================================================================

[State 20000, Disappear]
type = DestroySelf
trigger1 = (parent, stateno = 6000) && (parent, animelem = 10); For Hyper: Society Laser
trigger2 = (parent, stateno = 6001) && (parent, animelem = 4); For Hyper: Society Laser
trigger3 = parent, stateno = [5000,5170]; If interrupted by getting hit

;---------------------------------------------------------------------------
; VFX - Level 2 Flash
[Statedef 20001]
anim = 999999
ctrl = 0

;=============Coding inspired from Pots===========================================
[State 20001, Lv2 BG Pal]
type = bgpalfx
trigger1 = time <= 5
time = 1
add = 256 -ceil(25.6 * time), 256 -ceil(25.6 * time), 256 -ceil(25.6 * time)
mul = 256 -floor(25.6 * time), 256 -floor(25.6 * time), 256
color = 256 -floor(25.6 * time)

[State 20001, Lv2 BG Pal]
type = bgpalfx
trigger1 = (time = [6, 69])
time = 1
mul = 160, 32, 240
color = 0

[State 20001, Lv2 BG Pal]
type = bgpalfx
trigger1 = time >= 70
time = 1
mul = ceil(51.2 * (time -40)), ceil(51.2 * (time -40)), 256
color = floor(51.2 * (time -40))
;====================================================================================

[State 20001, Disappear]
type = DestroySelf
trigger1 = (parent, stateno = 6002) && (parent, animelem = 10); For Hyper: The Power
trigger2 = (parent, stateno = 6003) && (parent, animelem = 5); For Hyper: Skeet Shot
trigger3 = parent, stateno = [5000,5170]; If interrupted by getting hit

;---------------------------------------------------------------------------
; VFX - Level 3 Flash
[Statedef 20002]
anim = 999999
ctrl = 0

;=============Coding inspired from Pots===========================================
[State 20002, Lv3 BG Pal: Flash]
type = bgpalfx
trigger1 = time <= 5
time = 1
add = 256 -ceil(25.6 * time), 256 -ceil(25.6 * time), 256 -ceil(25.6 * time)
mul = 256 -floor(25.6 * time), 256 -floor(25.6 * time), 256
color = 256 -floor(25.6 * time)

[State 20002, Lv3 BG Pal: Slowly remove flash]
type = bgpalfx
trigger1 = (time = [6, 69])
time = 1
mul = 149, 53, 83
color = 0

[State 20002, Lv3 BG Pal: stay red]
type = bgpalfx
trigger1 = time >= 70
time = 30
mul = ceil(51.2 * (time -40)), ceil(51.2 * (time -40)), 256
color = floor(51.2 * (time -40))
;====================================================================================

;=============Coding inspired from OHMSBY===========================================
[State 20002, Hyper Portrait]
type = Explod
trigger1 = time = 0
anim = 20002
ID = 20000
pos = 320,700
postype = back
bindtime = -1
removetime = 98
scale = 1,1
supermove = 1
ontop = 1
sprpriority = 100
pausemovetime = -1

[State 20002, Hyper Portrait: Fade In]
type = modifyexplod
trigger1 = time <= 10
trans = addalpha
alpha = 25*(time-0),256-(25*(time-0))
id = 20000

[State 20002, Hyper Portrait: Fade Out]
type = modifyexplod
trigger1 = time >= 31
trans = addalpha
alpha = 256-(25*(time-31)),25*(time-31)
id = 20000
;====================================================================================

[State 20002, Disappear]
type = DestroySelf
trigger1 = numexplod(20000) = 0
;---------------------------------------------------------------------------
; VFX - Hyper Background
[Statedef 21000]
anim = 999999
ctrl = 0

[State 21000, Hyper Background]
type = Explod
triggerall = !(parent, stateno = 6003); If Hyper: Skeet Shot is used. That hyper doesn't need a hyper background.
trigger1 = !time
anim = 701
ID = 700
pos = 0,0
postype = back
bindtime = -1
removetime = -1
scale = 2,2
sprpriority = -1

[State 21000, Glass Break]
type = explod
triggerall = !numhelper(8000); Don't use it if hyper finish cinematic is played
trigger1 = (parent, stateno = 6000) && (parent, animelem = 27); For Hyper: Society Laser
trigger2 = (parent, stateno = 6001) && (parent, animelem = 23); For Hyper: Lantern Hammer
trigger3 = (parent, stateno = 6002) && (parent, animelem = 40); For Hyper: The Power
trigger4 = (parent, stateno = 6003) && (parent, animelem = 6) && (parent, movehit); For Hyper: Skeet Shot
trigger5 = parent, stateno = [5000,5170];	interrupted by hit
anim = 703
pos = 0,0
id = 703
vfacing = 1
bindtime = -1
postype = back
scale = 2,2
sprpriority = 8
removetime = -2
ownpal = 1
removeongethit = 1
persistent = 0
removetime = -2

[State 21000, "Break" Hyper Background "into pieces"]
type = RemoveExplod
trigger1 = (parent, stateno = 6000) && (parent, animelem = 27); For Hyper: Society Laser
trigger2 = (parent, stateno = 6001) && (parent, animelem = 23); For Hyper: Lantern Hammer
trigger3 = (parent, stateno = 6002) && (parent, animelem = 40); For Hyper: The Power
trigger4 = parent, stateno = [5000,5170];	interrupted by hit
trigger5 = numhelper(8000) = 1;	If hyper move finishes off opponent
id = 700

[State 21000, Glass Break SFX]
type = PlaySnd
trigger1 = NumExplod(703) = 1
value = S10,2
persistent = 0

[State 21000, Disappear]
type = DestroySelf
trigger1 = (parent, Animtime = 0)
;---------------------------------------------------------------------------


