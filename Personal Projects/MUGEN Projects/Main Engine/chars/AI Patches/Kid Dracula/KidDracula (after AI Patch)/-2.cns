;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2]
type = DisplayToClipboard
trigger1 = 1
text = "Var(59)-Button=%d,Pos X=%d,Y=%d"
params = var(59),floor(Pos X),floor(Pos Y)

[State -2, Debug Info]
type = DisplayToClipboard
trigger1 = roundstate > 0
text = "AI = %d, Super Jump = %d, SJ Direction = %d, Dampener = %f"
params = var(59), var(12), var(13), fVar(10)

[State -1, Helper]
type = Helper
trigger1 = NumHelper(9000) = 0
trigger1 = stateno = 3500
stateno = 9000
id = 9000
name = "Super Armor"
keyctrl = 0
ownpal = 1

[State -1, VarSet]
type = VarSet
trigger1 = NumHelper(9000) = 1
var(9) = 1
ignorehitpause = 1

[State -2, Explod]
type = Explod
triggerall = time = 1
trigger1 = anim = 5300
id = 5300
anim = 777
pos = -3,-70
postype = p1
bindtime = -1
removetime = -1
pausemovetime = 0
scale = 2.25,2.25
sprpriority = 1
removeongethit = 1

[State 3500, Helper]
type = Helper
triggerall = stateno = [3500,3599]
trigger1 = life = 0
helpertype = normal ;player
name = "Lose Music Base"
id = 3506
stateno = 3506
pos = 0,0
postype = p1
ignorehitpause = 1

[State -2, Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(8400) = 0)
trigger1 = stateno = [3000,3199]
helpertype = Normal
name = "Super Finish"
id = 8400
pos = 0,0
postype = p1
facing = 0
stateno = 8400
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

[State -2, Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(8400) = 0)
trigger1 = stateno = [3300,3999]
helpertype = Normal
name = "Super Finish"
id = 8400
pos = 0,0
postype = p1
facing = 0
stateno = 8400
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

[State -2, Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(8410) = 0)
trigger1 = stateno = [3200,3299]
helpertype = Normal
name = "Parodius Finish"
id = 8410
pos = 0,0
postype = p1
facing = 0
stateno = 8410
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = anim = [0,5299]
trigger2 = anim = [5301,99999]
id = 5300
ignorehitpause = 1

[State -2, jump]
type = PlaySnd
triggerall = time = 1
trigger1 = Stateno = 50
trigger2 = Stateno = 105
value = 40,1
volume = 200

[State -2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
value = 5000,random%2
channel = 5

[State -2, Helper]
type = Helper
trigger1 = Time = 0
trigger1 = !NumHelper(900)
ID = 900
pos = 40,-10
postype = back
stateno = 900
helpertype = normal
name = "Bat Friend"
keyctrl = 0
ownpal = 1
supermovetime = 9999999999999999
pausemovetime = 9999999999999999

[State -2, StopSnd]
type = StopSnd
trigger1 = stateno != [3000,3999]
trigger2 = MoveType = H
ignorehitpause = 1
channel = 2

;Damage Dampener ==================================================
;The damage dampener exists for public release of a character. In general
;since the MvC style characters can chain more attacks together it's
;easier to defeat other "normal" mugen characters. This damage dampener
;esists to help mitigate this issue. This dampener will be disabled for the
;1.0 full release of SMvC - EoH.

[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(12)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
fvar(12)=0

[State -2, Dampener]
type=varset
trigger1=1
fvar(10)= ifelse(fvar(12)<9,ifelse(fvar(12)=0, 1, ifelse(fvar(12)=1, .9, .86**fvar(12))),.25)
ignorehitpause=1

[State -2, Dampener itself]
type=attackmulset
trigger1= 1
value= fvar(10)
ignorehitpause=1
