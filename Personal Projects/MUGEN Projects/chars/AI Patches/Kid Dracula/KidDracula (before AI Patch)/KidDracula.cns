;---------------------------------------------------------------------------
; Win pose 3
; CNS difficulty: basic
[Statedef 183]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 183, distance X_right]
type = VarSet
trigger1 = facing = 1
trigger1 = time = 0
var(20) = floor(ifelse((enemy,facing = -1),(enemy,FrontEdgeDist - BackEdgeDist),(enemy,BackEdgeDist - BackEdgeDist)))

[State 183, distance X_left]
type = VarSet
trigger1 = facing = -1
trigger1 = time = 0
var(20) = floor(ifelse((enemy,facing = 1),(FrontEdgeDist - enemy,BackEdgeDist),(FrontEdgeDist - enemy,FrontEdgeDist)))

[State 183, time for distance]
type = VarSet
trigger1 = time = 0
var(21) = floor(var(20)/30)

[State 183, run_anim]
type = ChangeAnim
trigger1 = time = 0
value = ifelse((var(21) >= 0), 20, 21)

[State 183, run]
type = VelSet
trigger1 = time = 0
x = var(21)

[State 183, stop]
type = VelSet
trigger1 = time = 30
x = 0

[State 183, anim]
type = Changeanim
trigger1 = time = 30
value = ifelse((var(21) >= 0), 182, 182)

[State 183, PlaySnd]
type = PlaySnd
triggerall = anim = 182
trigger1 = animelem = 2
trigger2 = animelem = 3
trigger3 = animelem = 4
trigger4 = animelem = 5
trigger5 = animelem = 6
trigger6 = animelem = 7
value = S183,0

