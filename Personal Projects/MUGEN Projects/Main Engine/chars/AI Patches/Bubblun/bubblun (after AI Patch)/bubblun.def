; Player information
[Info]
name = "Bubblun"        ;Name of character
displayname = "Bubblun (After AI Patch)" ;Name of character to display
versiondate = 10,23,2015    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Gladiacloud"      ;Character author name
pal.defaults = 1            ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = bubblun(coolaipatch).cmd           ;Command set
cns     = bubblun.cns           ;Constants
st      = bubblun.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = bubblun.sff           ;Sprite
anim    = bubblun.air           ;Animation
sound   = bubblun.snd           ;Sound

[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
x2 = 7 ;Hold Start and press button X for palette 7, etc.
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12
