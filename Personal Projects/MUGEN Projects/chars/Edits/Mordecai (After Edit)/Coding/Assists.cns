value = 1004

[State 1003, Get countered, loser!]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1004
time = 20
ignorehitpause = 1
persistent = 1

[State 1003, Attack Player]
